# Copy to .env and fill locally. Never commit .env.
# OpenAI — leave empty for deterministic mock/fixture mode (required for QA without key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL_ALT: failover endpoint for the M11 LLM chain
# (Responses -> Chat on primary, then Responses -> Chat on alt; any failure
# fails over, first success wins). Empty = inert single-endpoint mode
# (existing behavior). Read from env only, never logged.
OPENAI_BASE_URL_ALT=
OPENAI_MODEL=gpt-4o-mini
# Scoring rubric (M11 VAL-CFG-058) — preset selection + file override.
# SCORING_PRESET: balanced (default, frozen weights) | strict (elder-protection) | lenient (bulk-triage).
# Unknown values fail startup loudly, never silently fall back to different weights.
SCORING_PRESET=balanced
# SCORING_RUBRIC_PATH: absolute path to a custom rubric JSON validated against config/rubrics/schema.json.
# Empty = use the shipped SCORING_PRESET file. When set, the override wins over SCORING_PRESET.
SCORING_RUBRIC_PATH=
LOG_LEVEL=info
# Error tracking — disabled by default. lib/sentry.ts captureException is a
# no-op unless this is set (requires human approval + Sentry SDK install).
SENTRY_DSN=
# Edge / site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EDGE_ORIGIN=http://localhost:3000
# Optional Postgres (Neon/Netlify DB) — stretch, not required for tracer
DATABASE_URL=
