# Copy to .env and fill locally. Never commit .env.
# OpenAI — leave empty for deterministic mock/fixture mode (required for QA without key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=info
# Error tracking — disabled by default. lib/sentry.ts captureException is a
# no-op unless this is set (requires human approval + Sentry SDK install).
SENTRY_DSN=
# Edge / site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EDGE_ORIGIN=http://localhost:3000
# Optional Postgres (Neon/Netlify DB) — stretch, not required for tracer
DATABASE_URL=
