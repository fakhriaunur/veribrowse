{
  "name": "veribrowse",
  "version": "0.1.0",
  "private": true,
  "description": "VeriBrowse — WebMCP site with scoreWebsite and checkClaim for elderly + nerd audit",
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.thresholds.lines=35",
    "test:quick": "vitest run",
    "test:timing": "vitest run --reporter=verbose --slow-test-threshold=100",
    "test:perf": "bash scripts/test_perf.sh",
    "replay": "vitest run tests/replay -v",
    "docs": "node scripts/gen_docs.mjs",
    "docs:typedoc": "typedoc",
    "docs:generate": "node scripts/gen_docs.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "openai": "7.10.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "autoprefixer": "10.5.4",
    "depcheck": "^1.4.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jscpd": "^5.1.2",
    "jsdom": "30.0.1",
    "knip": "^6.34.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
