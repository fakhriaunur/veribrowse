{
  "name": "veribrowse",
  "version": "0.1.0",
  "private": true,
  "description": "VeriBrowse — WebMCP site with scoreWebsite and checkClaim for elderly + nerd audit",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type": "tsc --noEmit",
    "test": "vitest run --coverage --coverage.thresholds.lines=35",
    "test:quick": "vitest run",
    "replay": "vitest run tests/replay -v"
  },
  "dependencies": {
    "next": "15.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.23.8",
    "openai": "4.52.7",
    "pino": "9.3.2"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.2",
    "eslint": "9.18.0",
    "eslint-config-next": "15.2.3",
    "prettier": "3.4.2",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "3.0.5",
    "jsdom": "25.0.1",
    "tailwindcss": "3.4.17",
    "postcss": "8.4.49",
    "autoprefixer": "10.4.20"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
